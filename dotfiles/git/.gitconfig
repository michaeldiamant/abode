[user]
	name = michaeldiamant
	email = michaeldiamant@users.noreply.github.com
[pull]
	rebase = false

[includeIf "gitdir:~/dev/work/"]
    path = ~/.gitconfig.work
[push]
	autoSetupRemote = true
[core]
	pager = less
	excludesfile = /Users/michael/.gitignore-global
[alias]
        top-files = "!f() { git log --format=format: --name-only --since='1 year ago' -- \"$@\" | grep -v '^$' | sort | uniq -c | sort -nr | head -n 20; }; f"
	top-contributors = "!f() { git --no-pager shortlog -sn --no-merges -- \"$@\"; }; f"
	top-bugs = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
	repo-speed = "!f() { git log --format='%ad' --date=format:'%Y-%m' -- \"$@\" | sort | uniq -c; }; f"
	firefights = "!f() { git log --graph --format='%C(yellow)%h%Creset %C(magenta)%ad%Creset %s' --date=short --since='1 year ago' -- \"$@\" | grep -iE 'revert|hotfix|emergency|broken'; }; f"

[fetch]
	prune = true
