{
  // IANA timezone used for the daily limit boundary and the Grafana dashboard
  "timezone": "America/New_York",
  "limits": [
    // Soft limit for daily target. Can exceed.
    {
      "name": "soft",
      "isPrimary": true,
      "showInStatus": true,
      // The daily limit you want to set for yourself.
      // 100 AIC = $1
      "dailyLimitAic": 1500.0,
      // At what percent should you get a warning in the TUI
      "warnAtPercent": 80.0,
      // Mode of operation
      // warn: Warn when reaching the limit
      // block: Block usage when limit is hit
      "mode": "warn"
    },
    // Hard limit for excessive usage. Can NOT exceed.
    {
      "name": "hard",
      "dailyLimitAic": 7500.0,
      "warnAtPercent": 75.0,
      "mode": "block"
    }
  ],
  // The default agent that commands use. For example, `tlsbxw up` will start this agent.
  // One of: copilot, opencode, pi
  "defaultAgent": "copilot"
}
